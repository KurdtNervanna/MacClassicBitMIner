; SHA-256 helper functions in 68000 assembly for THINK Pascal 4.0+
;
; *** EXPERIMENTAL / UNVERIFIED optimization path ***
; The pure-Pascal implementation in BitcoinMiner.pas is the validated default
; (see reference/ for the 46-check proof). These routines are a drop-in speed
; optimization but have NOT been assembled or run on hardware yet. If you build
; with them and the Self-Test button reports FAIL, remove them and use the
; Pascal versions.
;
; --- Fixes vs. the earlier version of this file ---
;  * Uses the correct THINK Pascal calling convention: parameters are on the
;    STACK (via LINK A6), not in registers. The old register-based version
;    could never have linked correctly against THINK Pascal.
;  * Uses the 68000's native ROR (rotate) instruction instead of a shift/OR
;    sequence -- shorter and faster, and exactly what ROTR needs.
;  * Names match the Pascal function names so swap-in needs no call-site edits.
;
; --- How to enable (see README "Assembly Optimization") ---
;  1. Add this file to the project and put {$L sha256.a} in BitcoinMiner.pas.
;  2. Comment out the 7 Pascal functions ROTR, Ch, Maj, BigSigma0, BigSigma1,
;     SmSigma0, SmSigma1 and declare them 'external' instead.
;  3. Rebuild and click Self-Test. It must say PASS.
;
; THINK Pascal stack frame after 'LINK A6,#0' (function with result):
;    8(A6)  = last (rightmost) parameter
;    ...    = earlier parameters, at higher addresses
;    8+P(A6)= 4-byte function-result slot  (P = total parameter bytes)
; A LongInt parameter is 4 bytes; an Integer parameter is 2 bytes.
; Epilogue removes the parameters and leaves the result on the stack (no RTD on
; the 68000).

        XDEF    ROTR
        XDEF    Ch
        XDEF    Maj
        XDEF    BigSigma0
        XDEF    BigSigma1
        XDEF    SmSigma0
        XDEF    SmSigma1

; -------------------------------------------------------------------------
; function ROTR(x: LongInt; n: Integer): LongInt;   rotate x right by n
;   8(A6)=n (Integer,2)  10(A6)=x (LongInt,4)  14(A6)=result   params=6
; -------------------------------------------------------------------------
ROTR:
        LINK    A6,#0
        MOVE.W  8(A6),D1        ; n
        ANDI.W  #31,D1          ; 0..31
        MOVE.L  10(A6),D0       ; x
        ROR.L   D1,D0           ; rotate right by n
        MOVE.L  D0,14(A6)       ; result
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDQ.L  #6,SP           ; drop 6 bytes of params
        JMP     (A0)

; -------------------------------------------------------------------------
; function Ch(x, y, z: LongInt): LongInt;   (x & y) ^ (~x & z)
;   8(A6)=z  12(A6)=y  16(A6)=x  20(A6)=result   params=12
; -------------------------------------------------------------------------
Ch:
        LINK    A6,#0
        MOVEM.L D2/D3,-(SP)
        MOVE.L  16(A6),D0       ; x
        MOVE.L  12(A6),D1       ; y
        MOVE.L  8(A6),D2        ; z
        MOVE.L  D0,D3           ; x
        AND.L   D1,D0           ; x & y
        NOT.L   D3              ; ~x
        AND.L   D2,D3           ; ~x & z
        EOR.L   D3,D0           ; (x & y) ^ (~x & z)
        MOVE.L  D0,20(A6)
        MOVEM.L (SP)+,D2/D3
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDA.W  #12,SP
        JMP     (A0)

; -------------------------------------------------------------------------
; function Maj(x, y, z: LongInt): LongInt;   (x&y) ^ (x&z) ^ (y&z)
;   8(A6)=z  12(A6)=y  16(A6)=x  20(A6)=result   params=12
; -------------------------------------------------------------------------
Maj:
        LINK    A6,#0
        MOVEM.L D2-D4,-(SP)
        MOVE.L  16(A6),D0       ; x
        MOVE.L  12(A6),D1       ; y
        MOVE.L  8(A6),D2        ; z
        MOVE.L  D0,D3           ; x
        AND.L   D1,D3           ; x & y
        MOVE.L  D0,D4           ; x
        AND.L   D2,D4           ; x & z
        EOR.L   D4,D3           ; (x&y) ^ (x&z)
        MOVE.L  D1,D4           ; y
        AND.L   D2,D4           ; y & z
        EOR.L   D4,D3           ; ^ (y&z)
        MOVE.L  D3,20(A6)
        MOVEM.L (SP)+,D2-D4
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDA.W  #12,SP
        JMP     (A0)

; -------------------------------------------------------------------------
; function BigSigma0(x: LongInt): LongInt;  ROTR(x,2) ^ ROTR(x,13) ^ ROTR(x,22)
;   8(A6)=x  12(A6)=result   params=4
; -------------------------------------------------------------------------
BigSigma0:
        LINK    A6,#0
        MOVEM.L D2/D5,-(SP)
        MOVE.L  8(A6),D5        ; x
        MOVE.L  D5,D0
        ROR.L   #2,D0           ; ROTR(x,2)
        MOVE.L  D5,D1
        MOVEQ   #13,D2
        ROR.L   D2,D1           ; ROTR(x,13)
        EOR.L   D1,D0
        MOVE.L  D5,D1
        MOVEQ   #22,D2
        ROR.L   D2,D1           ; ROTR(x,22)
        EOR.L   D1,D0
        MOVE.L  D0,12(A6)
        MOVEM.L (SP)+,D2/D5
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDQ.L  #4,SP
        JMP     (A0)

; -------------------------------------------------------------------------
; function BigSigma1(x: LongInt): LongInt;  ROTR(x,6) ^ ROTR(x,11) ^ ROTR(x,25)
; -------------------------------------------------------------------------
BigSigma1:
        LINK    A6,#0
        MOVEM.L D2/D5,-(SP)
        MOVE.L  8(A6),D5
        MOVE.L  D5,D0
        MOVEQ   #6,D2
        ROR.L   D2,D0           ; ROTR(x,6)
        MOVE.L  D5,D1
        MOVEQ   #11,D2
        ROR.L   D2,D1           ; ROTR(x,11)
        EOR.L   D1,D0
        MOVE.L  D5,D1
        MOVEQ   #25,D2
        ROR.L   D2,D1           ; ROTR(x,25)
        EOR.L   D1,D0
        MOVE.L  D0,12(A6)
        MOVEM.L (SP)+,D2/D5
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDQ.L  #4,SP
        JMP     (A0)

; -------------------------------------------------------------------------
; function SmSigma0(x: LongInt): LongInt;  ROTR(x,7) ^ ROTR(x,18) ^ (x >> 3)
; -------------------------------------------------------------------------
SmSigma0:
        LINK    A6,#0
        MOVEM.L D2/D5,-(SP)
        MOVE.L  8(A6),D5
        MOVE.L  D5,D0
        MOVEQ   #7,D2
        ROR.L   D2,D0           ; ROTR(x,7)
        MOVE.L  D5,D1
        MOVEQ   #18,D2
        ROR.L   D2,D1           ; ROTR(x,18)
        EOR.L   D1,D0
        MOVE.L  D5,D1
        LSR.L   #3,D1           ; x >> 3  (logical shift, zero fill)
        EOR.L   D1,D0
        MOVE.L  D0,12(A6)
        MOVEM.L (SP)+,D2/D5
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDQ.L  #4,SP
        JMP     (A0)

; -------------------------------------------------------------------------
; function SmSigma1(x: LongInt): LongInt;  ROTR(x,17) ^ ROTR(x,19) ^ (x >> 10)
; -------------------------------------------------------------------------
SmSigma1:
        LINK    A6,#0
        MOVEM.L D2/D5,-(SP)
        MOVE.L  8(A6),D5
        MOVE.L  D5,D0
        MOVEQ   #17,D2
        ROR.L   D2,D0           ; ROTR(x,17)
        MOVE.L  D5,D1
        MOVEQ   #19,D2
        ROR.L   D2,D1           ; ROTR(x,19)
        EOR.L   D1,D0
        MOVE.L  D5,D1
        MOVEQ   #10,D2
        LSR.L   D2,D1           ; x >> 10
        EOR.L   D1,D0
        MOVE.L  D0,12(A6)
        MOVEM.L (SP)+,D2/D5
        UNLK    A6
        MOVE.L  (SP)+,A0
        ADDQ.L  #4,SP
        JMP     (A0)

        END
